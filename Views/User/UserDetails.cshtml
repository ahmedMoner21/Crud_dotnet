@model AZMStore.Models.User

<h2>User Details</h2>

<div class="card p-4" style="max-width: 500px;">

    <h4>@Model.Name</h4>

    <hr />

    <dl class="row">

        @* <dt class="col-sm-4">ID</dt>
        <dd class="col-sm-8">@Model.Id</dd> *@

        <dt class="col-sm-4">Name</dt>
        <dd class="col-sm-8">@Model.Name</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4">Phone</dt>
        <dd class="col-sm-8">@Model.Phone</dd>

    </dl>

    <a asp-controller="User" asp-action="SelectAll" class="btn btn-secondary">Back to Users</a>
    <a asp-controller="User" asp-action="UpdateForm" asp-route-id="@Model.Id" class="btn btn-secondary">Edit User</a>
    <a asp-controller="User" asp-action="DeleteUser" asp-route-id="@Model.Id" class="btn btn-danger">Delete User</a>

</div>